<?xml version="1.0"?>
<ruleset name="NpcinkWorkflowToolbox">
	<description>WordPress Coding Standards for Toolbox runtime PHP.</description>

	<file>includes</file>
	<file>npcink-workflow-toolbox.php</file>
	<file>uninstall.php</file>
	<file>modules/local-automation-runtime/src</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core">
		<!-- Underscore class filenames back the plugin bootstrap and the
			tooling-only PSR-4 autoload mapping; WordPress hyphenated
			class-file naming would break them. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="npcink-workflow-toolbox"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Not auto-fixable and not correctness-relevant; short ternaries,
	     non-Yoda comparisons, and reserved-word parameter names are
	     established patterns in this codebase. Silenced errors are
	     deliberate WordPress-version guards. -->
	<rule ref="Universal.Operators.DisallowShortTernary.Found">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.PHP.YodaConditions.NotYoda">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors.Discouraged">
		<severity>0</severity>
	</rule>

	<config name="testVersion" value="8.0-"/>
</ruleset>
