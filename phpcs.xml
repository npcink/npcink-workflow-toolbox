<?xml version="1.0"?>
<ruleset name="NpcinkWorkflowToolbox">
	<description>WordPress Coding Standards for Toolbox runtime PHP.</description>

	<file>includes</file>
	<file>npcink-workflow-toolbox.php</file>
	<file>uninstall.php</file>
	<file>modules/local-automation-runtime/src</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core">
		<!-- Underscore class filenames back the plugin bootstrap and the
			tooling-only PSR-4 autoload mapping; WordPress hyphenated
			class-file naming would break them. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="npcink-workflow-toolbox"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="8.0-"/>
</ruleset>
