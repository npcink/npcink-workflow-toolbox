{
  "contract": "article_review_quality_cases.v1",
  "source_policy": "synthetic_no_customer_content",
  "checks": [
    "language",
    "logic",
    "content_risk"
  ],
  "purpose": "Frozen bounded development screen, not independent gold or general accuracy",
  "targets": {
    "positive_case_hit_min": 0.8,
    "negative_case_false_alarm_max": 0.1,
    "invalid_quote_ranges_max": 0,
    "wordpress_writes_max": 0
  },
  "cases": [
    {
      "id": "logic-contradiction",
      "group": "logic",
      "expectation": "hint",
      "expected_kinds": [
        "contradiction"
      ],
      "blocks": [
        {
          "block_ref": "b1",
          "kind": "body",
          "text": "这项服务在2025年对所有用户永久免费。"
        },
        {
          "block_ref": "b2",
          "kind": "body",
          "text": "同一项服务在整个2025年对所有用户每月收费29元，没有免费版本。"
        }
      ]
    },
    {
      "id": "logic-numeric",
      "group": "logic",
      "expectation": "hint",
      "expected_kinds": [
        "numeric_consistency"
      ],
      "blocks": [
        {
          "block_ref": "b1",
          "kind": "body",
          "text": "2025年甲项目总支出10万元。"
        },
        {
          "block_ref": "b2",
          "kind": "body",
          "text": "上文同一时期同一项目总支出12万元，两处均包含全部费用。"
        }
      ]
    },
    {
      "id": "logic-inference",
      "group": "logic",
      "expectation": "hint",
      "expected_kinds": [
        "inference_gap"
      ],
      "blocks": [
        {
          "block_ref": "b1",
          "kind": "body",
          "text": "本次测试只访问了两家门店，两家门店当日都没有缺货。"
        },
        {
          "block_ref": "b2",
          "kind": "body",
          "text": "因此可以证明，全国所有门店在未来十年绝不会缺货。"
        }
      ]
    },
    {
      "id": "logic-verification",
      "group": "logic",
      "expectation": "hint",
      "expected_kinds": [
        "needs_verification"
      ],
      "blocks": [
        {
          "block_ref": "b1",
          "kind": "body",
          "text": "本文宣称这款普通保健食品能百分之百治愈所有癌症，但没有提供任何临床研究、适用条件或来源。"
        }
      ]
    },
    {
      "id": "logic-within-numeric",
      "group": "logic",
      "expectation": "hint",
      "expected_kinds": [
        "numeric_consistency"
      ],
      "blocks": [
        {
          "block_ref": "b1",
          "kind": "body",
          "text": "本月同一账户总收入1000元，总支出800元，除此之外无其他收支或调整，因此本月净增加500元。"
        }
      ]
    },
    {
      "id": "logic-year-control",
      "group": "logic",
      "expectation": "no_hint",
      "expected_kinds": [],
      "blocks": [
        {
          "block_ref": "b1",
          "kind": "body",
          "text": "项目2024年总支出10万元，2025年总支出12万元，两个数字分别对应不同年度。"
        }
      ]
    },
